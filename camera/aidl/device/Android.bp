soong_config_module_type {
    name: "lineage_camera_device_config_default",
    module_type: "cc_defaults",
    config_namespace: "lineage_camera",
    bool_variables: [
        "legacy_jpeg_blob_fixup",
    ],
    properties: ["cflags"],
}

lineage_camera_device_config_default {
    name: "lineage_camera_device_config_default",
    soong_config_variables: {
        legacy_jpeg_blob_fixup: {
            cflags: ["-DLEGACY_JPEG_BLOB_FIXUP"],
        },
    },
}

cc_library_shared {
    name: "camera.device-impl.lineage",
    defaults: [
        "android.hardware.graphics.common-ndk_shared",
        "lineage_camera_device_config_default",
    ],
    vendor: true,
    srcs: [
        "CameraDevice.cpp",
        "CameraDeviceSession.cpp",
        "JpegBlobFixup.cpp",
        "convert.cpp",
    ],
    shared_libs: [
        "android.hardware.camera.common-V1-ndk",
        "android.hardware.camera.device-V1-ndk",
        "libbinder_ndk",
        "libcamera_metadata",
        "libcutils",
        "libfmq",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libui",
        "libutils",
    ],
    static_libs: [
        "android.hardware.camera.common-helper",
        "libaidlcommonsupport",
    ],
    export_include_dirs: ["."],
}
